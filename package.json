{
  "name": "shipnow-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API ShipNow con arquitectura por capas",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "npm run test:unit && npm run test:functional",
    "test:unit": "node --test",
    "test:functional": "mocha --file tests/functional/setup.js \"tests/functional/**/*.spec.js\" --timeout 120000 --exit",
    "audit": "npm audit --audit-level=moderate",
    "check": "npm run audit && npm test"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "mongoose": "^8.12.0",
    "winston": "^3.19.0",
    "swagger-ui-express": "^5.0.1",
    "multer": "2.5.0"
  },
  "devDependencies": {
    "mocha": "^12.0.3",
    "chai": "^6.3.0",
    "supertest": "^7.3.2",
    "mongodb-memory-server": "^11.3.0"
  },
  "overrides": {
    "mocha": {
      "glob": "14.0.2",
      "minimatch": "11.0.1"
    },
    "glob": {
      "minimatch": "11.0.1"
    }
  }
}
